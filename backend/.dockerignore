# Build context = backend/. Keep it lean: never ship the 3.1 GB of models,
# runtime artifacts, caches, or secrets into the image (models live on a
# Render persistent disk and lazy-download at runtime).
models/
.tv_clips/
.tv_uploads/
.tv_camera_loops/
.citizen_index/
.vendor_pageindex/
*.pt
*.onnx

# secrets — set as Render env vars, never baked into the image
.env
.env.*

# python caches / local venvs
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# dead legacy ad-hoc scripts at backend root (not the real app)
test_*.py

# vcs / editor
.git/
.gitignore
*.md
