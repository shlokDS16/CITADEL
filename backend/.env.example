# =====================================================
# CITADEL Backend — Environment Variables
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit real credentials.
# =====================================================

# --- Supabase (Postgres + Auth + Storage) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OCR Space (text extraction from scanned PDFs / images) ---
OCR_SPACE_API_KEY=your-ocr-space-key

# --- Groq (document classification via Llama-3.3-70B) ---
GROQ_API_KEY=gsk_your-groq-key
GROQ_CLASSIFIER_MODEL=llama-3.3-70b-versatile

# --- Server ---
APP_ENV=development        # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# --- Storage buckets (Supabase Storage) ---
SUPABASE_BUCKET_DOCUMENTS=documents
SUPABASE_BUCKET_PROCESSED=processed

# --- Limits ---
MAX_UPLOAD_SIZE_MB=10
MAX_BATCH_SIZE=10
OCR_SPACE_MAX_REQUEST_MB=1

# --- Embeddings (local model, no API call) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
