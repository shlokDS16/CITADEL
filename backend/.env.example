# =====================================================
# CITADEL Backend — Environment Variables
# Copy this file to `backend/.env` and fill in real values.
# `.env` is gitignored. NEVER commit real credentials.
# On Render, set these in the dashboard (render.yaml marks secrets sync:false).
# =====================================================

# ---- Supabase (DB + storage) --------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only needed to run migrations / DB audits directly (psycopg2), not by the app.
# Supabase -> Project Settings -> Database -> Connection string (session pooler).
SUPABASE_DB_URL=postgresql://postgres.PROJECT:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
SUPABASE_BUCKET_DOCUMENTS=documents
SUPABASE_BUCKET_PROCESSED=processed
SUPABASE_BUCKET_RESUMES=resumes

# ---- Auth (Phase 3) -----------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE-ME-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# ---- LLM (Groq primary) -------------------------------------------------
GROQ_API_KEY=gsk_your_groq_key
# Optional backup key. When the primary hits its daily token cap (HTTP 429)
# or is disabled (401/403), every Groq call transparently retries on this
# one with the same model. Leave blank to disable failover.
GROQ_API_KEY_2=
GROQ_CLASSIFIER_MODEL=llama-3.3-70b-versatile
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# ---- Gemini (cross-provider LLM fallback) -------------------------------
# Kicks in for the RAG assistant + fake-news Layer-4 rationale when BOTH
# Groq keys hit the 100k-tokens/day free cap. Get one at
# https://aistudio.google.com/apikey . Leave blank to disable.
GEMINI_API_KEY=

# ---- OCR (OCR.Space free tier) ------------------------------------------
OCR_SPACE_API_KEY=your-ocr-space-key
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
OCR_SPACE_MAX_REQUEST_MB=1

# ---- Telegram (OPTIONAL, leave BLANK unless you run your own bot) -------
# Both are intentionally EMPTY by default. Telegram alerts are a per-account
# feature: each signed-in user connects their own chat from the dashboard
# (Telegram Alerts card), so nothing is needed here to run CITADEL.
#
# TELEGRAM_BOT_TOKEN: set this ONLY if you want to provide a shared bot for
#   your deployment (create one via @BotFather). Users can then supply just
#   their chat id instead of their own token. Leave blank and every user
#   simply brings their own bot token.
# TELEGRAM_DEFAULT_CHAT_ID: LEAVE BLANK IN ANY SHARED/PUBLIC DEPLOYMENT.
#   It is a fallback recipient: every alert without a per-user config goes
#   to this chat. Setting it to your personal chat means other people's
#   traffic/anomaly alerts land on YOUR phone. Blank = no fallback, alerts
#   are simply skipped until a user connects their own chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# ---- Fake-news detector (Citizen M2) ------------------------------------
GOOGLE_FACTCHECK_API_KEY=optional-google-factcheck-key
FN_ENABLE_HEAVY_MODELS=false
FN_MODELS_DIR=/data/models

# ---- Server -------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated. Add your Vercel frontend URL in production.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# ---- Tunables (safe defaults) -------------------------------------------
MAX_UPLOAD_SIZE_MB=10
MAX_BATCH_SIZE=10
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
COST_PER_HIRE_RUPEES=18000
RESUME_AUTO_SHORTLIST_DEFAULT=70
