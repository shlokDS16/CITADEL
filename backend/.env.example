# =====================================================
# CITADEL Backend — Environment Variables
# Copy this file to `backend/.env` and fill in real values.
# `.env` is gitignored. NEVER commit real credentials.
# On Render, set these in the dashboard (render.yaml marks secrets sync:false).
# =====================================================

# ---- Supabase (DB + storage) --------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only needed to run migrations / DB audits directly (psycopg2), not by the app.
# Supabase -> Project Settings -> Database -> Connection string (session pooler).
SUPABASE_DB_URL=postgresql://postgres.PROJECT:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
SUPABASE_BUCKET_DOCUMENTS=documents
SUPABASE_BUCKET_PROCESSED=processed
SUPABASE_BUCKET_RESUMES=resumes

# ---- Auth (Phase 3) -----------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE-ME-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# ---- LLM (Groq primary) -------------------------------------------------
GROQ_API_KEY=gsk_your_groq_key
GROQ_CLASSIFIER_MODEL=llama-3.3-70b-versatile
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# ---- OCR (OCR.Space free tier) ------------------------------------------
OCR_SPACE_API_KEY=your-ocr-space-key
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
OCR_SPACE_MAX_REQUEST_MB=1

# ---- Telegram (shared platform bot; users can also add their own) -------
# Create a bot via @BotFather; get your chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=123456789:your-bot-token
TELEGRAM_DEFAULT_CHAT_ID=your-numeric-chat-id
TELEGRAM_API_BASE=https://api.telegram.org

# ---- Fake-news detector (Citizen M2) ------------------------------------
GOOGLE_FACTCHECK_API_KEY=optional-google-factcheck-key
FN_ENABLE_HEAVY_MODELS=false
FN_MODELS_DIR=/data/models

# ---- Server -------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated. Add your Vercel frontend URL in production.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# ---- Tunables (safe defaults) -------------------------------------------
MAX_UPLOAD_SIZE_MB=10
MAX_BATCH_SIZE=10
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
COST_PER_HIRE_RUPEES=18000
RESUME_AUTO_SHORTLIST_DEFAULT=70
